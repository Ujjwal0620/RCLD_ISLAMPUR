NEXT_PUBLIC_APP_NAME=RCLD Islampur
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local MongoDB for UI/business-logic testing
MONGODB_URI=mongodb://127.0.0.1:27017/rcld_islampur
AUTH_SECRET=change-this-local-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_ENV=SANDBOX

# Groq AI
# Keep the real API key only in your local .env/.env.local or deployment environment.
# Never commit a real Groq API key to GitHub.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
